---
/** A money amount with an optional "per period" picker beside it. */
interface Props {
  name: string;
  label: string;
  value?: string;
  hint?: string;
  period?: string;
  periodName?: string;
  periods?: string[];
}
const { name, label, value = "", hint, period = "year", periodName, periods = ["year", "month", "week", "day", "hour"] } = Astro.props;
const describedBy = [hint && `${name}-hint`, `${name}-error`].filter(Boolean).join(" ");
---
<div class="field salary">
  <label for={name}>{label}</label>
  {hint && <p class="hint" id={`${name}-hint`}>{hint}</p>}
  <div class="salary-row">
    <div class="control has-prefix">
      <span class="affix prefix" aria-hidden="true">£</span>
      <input
        id={name}
        name={name}
        type="text"
        inputmode="decimal"
        autocomplete="off"
        enterkeyhint="done"
        value={value}
        placeholder="0"
        required
        aria-describedby={describedBy}
      />
    </div>
    {periodName && (
      <>
        <label for={periodName} class="sr-only">{label}: paid per</label>
        <select id={periodName} name={periodName}>
          {periods.map((p) => <option value={p} selected={p === period}>per {p}</option>)}
        </select>
      </>
    )}
  </div>
  <p class="field-error" id={`${name}-error`} hidden></p>
</div>
