---
/** A collapsible group of optional inputs. app.ts writes a short summary of its values into the hint. */
interface Props {
  title: string;
  hint: string;
}
const { title, hint } = Astro.props;
---
<details class="section" data-hint={hint}>
  <summary>
    <span class="section-title">{title}</span>
    <span class="section-hint"></span>
    <svg class="chevron" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
  </summary>
  <div class="section-body">
    <slot />
  </div>
</details>
