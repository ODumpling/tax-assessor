---
import Calc from "./Calc.astro";
import Field from "./Field.astro";
import Options from "./Options.astro";
import SalaryField from "./SalaryField.astro";
import Section from "./Section.astro";

interface Props {
  period: "year" | "hour";
  value: string;
}
const { period, value } = Astro.props;
const hourly = period === "hour";
---
<Calc periods={["year", "month", "week", "day", "hour"]} period={hourly ? "week" : "month"}>
  <div class="group">
    <SalaryField name="salary" label={hourly ? "Hourly rate" : "Gross salary"} hint={hourly ? undefined : "Before tax, as on your contract."} value={value} period={period} periodName="period" />
    {hourly && <Field name="hoursPerWeek" label="Hours per week" value="37.5" suffix="hours" />}
  </div>
  <Options hideHours={hourly} />
  <Section title="Overtime and bonus" hint="extra">
    <Field name="overtimeHours" label="Overtime hours per week" suffix="hours" />
    <div class="field">
      <label for="overtimeRate">Overtime rate</label>
      <select id="overtimeRate" name="overtimeRate">
        <option value="1">Normal (1×)</option>
        <option value="1.5">Time and a half (1.5×)</option>
        <option value="2">Double time (2×)</option>
      </select>
    </div>
    <Field name="bonus" label="Annual bonus" money />
  </Section>
</Calc>

<script>
  import { calculate } from "../engine/calculate";
  import { toAnnual, type Period } from "../engine/periods";
  import { need, num, readOptions, renderBreakdown, start, str } from "../client/app";

  start(() => {
    const { year, input, work } = readOptions();
    const base = toAnnual(need("salary"), (str("period") || "year") as Period, work);
    const hourly = work.hoursPerWeek > 0 ? base / (52 * work.hoursPerWeek) : 0;
    const overtime = num("overtimeHours") * 52 * hourly * num("overtimeRate", 1);
    const full = { ...input, salary: base + overtime + num("bonus") };
    renderBreakdown(calculate(full, year), full, year, work);
  });
</script>
