---
import Base from "../layouts/Base.astro";
import Calc from "../components/Calc.astro";
import Options from "../components/Options.astro";
import SalaryField from "../components/SalaryField.astro";
---
<Base title="Compare tax years" description="See how the same salary is taxed in each tax year.">
  <Calc period="year">
    <div class="group">
      <SalaryField name="salary" label="Gross salary" hint="A year, before tax." value="35000" />
    </div>
    <Options hideYear />
  </Calc>

  <script>
    import { calculate } from "../engine/calculate";
    import { fromAnnual } from "../engine/periods";
    import { allYears, money, need, period, perWord, readOptions, renderComparison, signed, spokenYear, start } from "../client/app";

    start(() => {
      const { input, work } = readOptions();
      const salary = need("salary");
      const show = period(["year", "month", "week"]);
      const cols = allYears.slice(-4).map((y) => ({ label: y.label, result: calculate({ ...input, salary }, y) }));
      const first = cols[0]!;
      const last = cols.at(-1)!;
      const now = fromAnnual(last.result.takeHome, show, work);
      const change = now - fromAnnual(first.result.takeHome, show, work);
      const since = cols.length > 1 ? `${signed(change)} compared with ${first.label}.` : "";
      renderComparison(cols, show, work, {
        title: `Take-home in ${last.label}`,
        figure: money(now),
        unit: perWord(show),
        sub: since,
        spoken: `Take-home in tax year ${spokenYear(last.label)}: ${money(now)} ${perWord(show)}. ${cols.length > 1 ? `${signed(change, true)} compared with ${spokenYear(first.label)}.` : ""}`,
        peek: [last.label, money(now)],
      });
    });
  </script>
</Base>
