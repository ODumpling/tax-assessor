---
import Base from "../layouts/Base.astro";
import Calc from "../components/Calc.astro";
import Options from "../components/Options.astro";
import SalaryField from "../components/SalaryField.astro";
---
<Base title="Compare two salaries" description="See how much more you'd actually take home from a pay rise or new job.">
  <Calc>
    <div class="group pair">
      <SalaryField name="a" label="Salary A" value="35000" />
      <SalaryField name="b" label="Salary B" value="45000" />
    </div>
    <Options />
  </Calc>

  <script>
    import { calculate } from "../engine/calculate";
    import { fromAnnual } from "../engine/periods";
    import { money, need, pct, period, perWord, readOptions, renderComparison, start } from "../client/app";

    start(() => {
      const { year, input, work } = readOptions();
      const a = calculate({ ...input, salary: need("a") }, year);
      const b = calculate({ ...input, salary: need("b") }, year);
      const show = period(["year", "month", "week"]);
      const gain = fromAnnual(b.takeHome - a.takeHome, show, work);
      const rise = b.gross - a.gross;
      const kept = rise !== 0 ? `You keep ${pct((b.takeHome - a.takeHome) / rise)} of the difference in salary.` : "";
      const word = gain > 0.005 ? "more" : gain < -0.005 ? "less" : "";
      renderComparison(
        [
          { label: "Salary A", result: a },
          { label: "Salary B", result: b },
        ],
        show,
        work,
        {
          title: "Salary B compared with A",
          figure: word ? money(Math.abs(gain)) : "No change",
          unit: word ? `${word} take-home ${perWord(show)}` : "in take-home",
          sub: kept,
          spoken: word ? `Salary B gives ${money(Math.abs(gain))} ${word} take-home ${perWord(show)}. ${kept}` : `Salary B gives the same take-home. ${kept}`,
          peek: ["Salary B", word ? `${money(Math.abs(gain))} ${word}` : "No change"],
        },
      );
    });
  </script>
</Base>
