---
import Base from "../layouts/Base.astro";
import Options from "../components/Options.astro";
import SalaryField from "../components/SalaryField.astro";
---
<Base title="Pro-rata salary calculator" description="See your salary and take-home pay for part-time or reduced hours, compared with full time.">
  <div class="calc">
    <form id="calc">
      <SalaryField name="salary" label="Full-time salary" value="30000" />
      <fieldset class="grid">
        <legend class="sr-only">Hours</legend>
        <label>Full-time hours per week <input name="fullHours" inputmode="decimal" value="37.5" /></label>
        <label>Your hours per week <input name="yourHours" inputmode="decimal" value="22.5" /></label>
      </fieldset>
      <Options />
    </form>
    <section id="results"><noscript><p class="error">The calculator needs JavaScript turned on.</p></noscript></section>
  </div>

  <script>
    import { calculate } from "../engine/calculate";
    import { proRata } from "../engine/periods";
    import { money0, num, readOptions, renderComparison, start } from "../client/app";

    start(() => {
      const { year, input, work } = readOptions();
      const full = num("salary");
      const fullHours = num("fullHours", 37.5);
      const yourHours = num("yourHours");
      const pr = proRata(full, fullHours, yourHours);
      const w = { ...work, hoursPerWeek: yourHours };
      renderComparison(
        [
          { label: `Full time (${fullHours}h)`, result: calculate({ ...input, salary: full }, year) },
          { label: `Pro-rata (${yourHours}h)`, result: calculate({ ...input, salary: pr }, year) },
        ],
        "month",
        w,
        `<p class="headline"><span>Pro-rata salary</span> <strong>${money0(pr)}</strong> <span>a year · monthly figures below</span></p>`,
      );
    });
  </script>
</Base>
