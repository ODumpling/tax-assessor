---
import Base from "../layouts/Base.astro";
import Calc from "../components/Calc.astro";
import Field from "../components/Field.astro";
import Options from "../components/Options.astro";
import SalaryField from "../components/SalaryField.astro";
---
<Base title="Pro-rata salary calculator" description="See your salary and take-home pay for part-time or reduced hours, compared with full time.">
  <Calc>
    <div class="group">
      <SalaryField name="salary" label="Full-time salary" hint="A year, before tax." value="30000" />
      <div class="pair">
        <Field name="fullHours" label="Full-time hours per week" value="37.5" suffix="hours" />
        <Field name="yourHours" label="Your hours per week" value="22.5" suffix="hours" />
      </div>
    </div>
    <Options hideHours />
  </Calc>

  <script>
    import { calculate } from "../engine/calculate";
    import { fromAnnual, proRata } from "../engine/periods";
    import { money, money0, need, pct, period, perWord, readOptions, renderComparison, start } from "../client/app";

    start(() => {
      const { year, input, work } = readOptions();
      const full = need("salary");
      const fullHours = need("fullHours");
      const yourHours = need("yourHours");
      const pr = proRata(full, fullHours, yourHours);
      const w = { ...work, hoursPerWeek: yourHours };
      const show = period(["year", "month", "week"]);
      const part = calculate({ ...input, salary: pr }, year);
      const share = fullHours > 0 ? `${pct(yourHours / fullHours)} of full time.` : "";
      renderComparison(
        [
          { label: `Full time (${fullHours} hours)`, result: calculate({ ...input, salary: full }, year) },
          { label: `Pro-rata (${yourHours} hours)`, result: part },
        ],
        show,
        w,
        {
          title: "Your pro-rata salary",
          figure: money0(pr),
          unit: "a year",
          sub: `${share} You take home ${money(fromAnnual(part.takeHome, show, w))} ${perWord(show)}.`,
          spoken: `Pro-rata salary ${money0(pr)} a year, ${share} Take-home ${money(fromAnnual(part.takeHome, show, w))} ${perWord(show)}.`,
          peek: ["Pro-rata", money0(pr)],
        },
        "Difference (pro-rata − full time)",
      );
    });
  </script>
</Base>
