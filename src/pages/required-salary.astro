---
import Base from "../layouts/Base.astro";
import Calc from "../components/Calc.astro";
import Options from "../components/Options.astro";
import SalaryField from "../components/SalaryField.astro";
---
<Base title="Required salary calculator" description="Find the gross salary you need for the take-home pay you want.">
  <Calc periods={["year", "month", "week", "day", "hour"]}>
    <div class="group">
      <SalaryField name="target" label="Take-home pay you want" hint="After tax and deductions." value="2500" period="month" periodName="period" periods={["year", "month", "week"]} />
    </div>
    <Options />
  </Calc>

  <script>
    import { calculate, requiredSalary } from "../engine/calculate";
    import { toAnnual, type Period } from "../engine/periods";
    import { InputError, money, money0, need, readOptions, renderBreakdown, spokenYear, start, str } from "../client/app";

    start(() => {
      const { year, input, work } = readOptions();
      const per = (str("period") || "month") as Period;
      const want = need("target");
      const gross = requiredSalary(toAnnual(want, per, work), input, year);
      if (!Number.isFinite(gross)) throw new InputError("That take-home figure can't be reached with these settings.");
      const full = { ...input, salary: Math.ceil(gross) };
      renderBreakdown(calculate(full, year), full, year, work, {
        title: "You need a salary of",
        figure: money0(Math.ceil(gross)),
        unit: "a year",
        sub: `to take home ${money(want)} a ${per} in ${year.label}.`,
        spoken: `You need a salary of ${money0(Math.ceil(gross))} a year to take home ${money(want)} a ${per} in tax year ${spokenYear(year.label)}.`,
        peek: ["You need", money0(Math.ceil(gross))],
      });
    });
  </script>
</Base>
